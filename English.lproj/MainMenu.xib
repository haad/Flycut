                                                    <button toolTip="Password managers, Firefox private windows and some tools mark copies as concealed or temporary (org.nspasteboard.ConcealedType / TransientType / AutoGeneratedType). On by default so such content is not saved; turn off to keep Firefox private-window clippings, which can then include passwords. Works on its own, also while Don't save passwords is off." verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="Cnc-b0-001">
                                                        <rect key="frame" x="36" y="262" width="271" height="16"/>
                                                        <buttonCell key="cell" type="check" title="Private-browsing &amp; temporary clipboards" bezelStyle="regularSquare" imagePosition="left" alignment="left" inset="2" id="Cnc-c0-002">
                                                            <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                                            <font key="font" metaFont="system"/>
                                                        </buttonCell>
                                                        <connections>
                                                            <binding destination="808" name="value" keyPath="values.skipConcealedTypes" id="Cnc-n0-003"/>
                                                        </connections>
                                                    </button>
                                                    <button toolTip="Skip strings whose length is listed and that mix upper- and lower-case letters, digits and symbols – typical of generated passwords. Works only while Don't save passwords is on." translatesAutoresizingMaskIntoConstraints="NO" id="Bxp-pI-XMk">
